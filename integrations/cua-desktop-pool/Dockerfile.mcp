FROM docker:29-cli AS docker-cli

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CUA_POOL_PROJECT_ROOT=/app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates gcc libc6-dev linux-libc-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY docker ./docker
RUN python -m pip install --no-cache-dir .

COPY scripts/mcp-container-entrypoint.sh /usr/local/bin/cua-pool-entrypoint
RUN chmod 0755 /usr/local/bin/cua-pool-entrypoint

EXPOSE 8767
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=12 \
  CMD python -c "import socket; s=socket.create_connection(('127.0.0.1',8767),5); s.close()" || exit 1

ENTRYPOINT ["/usr/local/bin/cua-pool-entrypoint"]
