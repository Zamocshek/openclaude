# Telegram API Credentials (Required - get from https://my.telegram.org/apps)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Runtime storage
# Defaults are deployment-local. In production, point runtime storage to a
# persistent volume outside the source tree.
# TELEGRAM_MCP_CONFIG_DIR is optional; set it when running an installed package
# from a dedicated deployment directory that contains .env.
TELEGRAM_MCP_CONFIG_DIR=
TELEGRAM_MCP_DATA_DIR=./data
TELEGRAM_MCP_SESSION_DIR=./data/session
TELEGRAM_MCP_LOG_FILE=./data/logs/mcp_errors.log
TELEGRAM_MCP_ASSISTANT_DB=./data/session/assistant_memory.sqlite3
TELEGRAM_MCP_CONTENT_DB=./data/session/content_workflow.sqlite3

# Session Management (Choose ONE)
# Option 1: File-based default session.
# A simple name is stored under TELEGRAM_MCP_SESSION_DIR; absolute paths are kept as-is.
TELEGRAM_SESSION_NAME=telegram_session
# Option 2: String-based session (if you generate one, e.g., using Telethon's string session generator)
TELEGRAM_SESSION_STRING=1231231232erfdfdffd

# Optional local web console
TELEGRAM_MCP_WEB_HOST=127.0.0.1
TELEGRAM_MCP_WEB_PORT=8765
# Set a token if the web console is reachable by anything except localhost.
TELEGRAM_MCP_WEB_TOKEN=

# MCP transport. Docker deployments use one long-lived HTTP process to avoid
# concurrent access to the same Telethon session databases.
TELEGRAM_MCP_TRANSPORT=stdio
TELEGRAM_MCP_HOST=127.0.0.1
TELEGRAM_MCP_PORT=8000

# Optional VPromotions provider API integration
VPROMOTIONS_API_URL=https://vpromotions.ru/api/v2
VPROMOTIONS_API_KEY=
VPROMOTIONS_TIMEOUT=30

# Optional TwiBoost provider API integration
TWIBOOST_API_URL=https://twiboost.com/api/v2
TWIBOOST_API_KEY=
TWIBOOST_TIMEOUT=30

# Optional Maton API Gateway integration. Keep the real key only in .env.
MATON_API_URL=https://api.maton.ai
MATON_API_KEY=
MATON_TIMEOUT=30

# Optional direct Bot API publisher. This is a resilient fallback when a Maton
# Telegram connection is unavailable. The token is never returned by MCP tools.
TELEGRAM_MCP_BOT_TOKEN=
TELEGRAM_MCP_BOT_TIMEOUT=30

# Channel themes and editorial format rules. Leave empty to use the bundled
# registry; confirmed descriptions can later replace its marked placeholders.
TELEGRAM_MCP_CHANNEL_PROFILES=
