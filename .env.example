# =============================================================================
# OpenClaude Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Only set the variables for the provider you want to use.
# All other sections can be left commented out.
# =============================================================================

# =============================================================================
# SYSTEM-WIDE SETUP (OPTIONAL)
# =============================================================================
# Instead of using a .env file per project, you can set these variables
# system-wide so OpenClaude works from any directory on your machine.
#
# STEP 1: Pick your provider variables from the list below.
# STEP 2: Set them using the method for your OS (see further down).
#
# ── Provider variables ───────────────────────────────────────────────
#
#   Option 1 — Anthropic:
#     ANTHROPIC_API_KEY=sk-ant-your-key-here
#     ANTHROPIC_MODEL=claude-sonnet-4-5              (optional)
#     ANTHROPIC_BASE_URL=https://api.anthropic.com   (optional)
#
#   Option 2 — OpenAI:
#     CLAUDE_CODE_USE_OPENAI=1
#     OPENAI_API_KEY=sk-your-key-here
#     OPENAI_MODEL=gpt-4o
#     OPENAI_BASE_URL=https://api.openai.com/v1      (optional)
#
#   Option 3 — Google Gemini:
#     CLAUDE_CODE_USE_GEMINI=1
#     GEMINI_API_KEY=your-gemini-key-here
#     GEMINI_MODEL=gemini-2.0-flash
#     GEMINI_BASE_URL=https://generativelanguage.googleapis.com  (optional)
#
#   Option 4 — GitHub Models:
#     CLAUDE_CODE_USE_GITHUB=1
#     GITHUB_TOKEN=ghp_your-token-here
#
#   Option 5 — Ollama (local):
#     CLAUDE_CODE_USE_OPENAI=1
#     OPENAI_BASE_URL=http://localhost:11434/v1
#     OPENAI_API_KEY=ollama
#     OPENAI_MODEL=llama3.2
#
#   Option 6 — LM Studio (local):
#     CLAUDE_CODE_USE_OPENAI=1
#     OPENAI_BASE_URL=http://localhost:1234/v1
#     OPENAI_MODEL=your-model-id-here
#     OPENAI_API_KEY=lmstudio                        (optional)
#     OPENCLAUDE_OPENAI_TEXT_TOOL_MODE=auto          (native tools first, compatible fallback)
#
#   Option 7 - OnlySQ:
#     CLAUDE_CODE_USE_OPENAI=1
#     OPENAI_BASE_URL=https://api.onlysq.ru/ai/openai
#     OPENAI_MODEL=gemini-3-flash
#     OPENAI_API_KEY=sq-your-key-here
#     # Do not append /v1 for OnlySQ; their OpenAI-compatible route is /ai/openai.
#
#   Option 8 - AWS Bedrock (may also need: aws configure):
#     CLAUDE_CODE_USE_BEDROCK=1
#     AWS_REGION=us-east-1
#     AWS_DEFAULT_REGION=us-east-1
#     AWS_BEARER_TOKEN_BEDROCK=your-bearer-token-here
#     ANTHROPIC_BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com
#
#   Option 9 — Google Vertex AI:
#     CLAUDE_CODE_USE_VERTEX=1
#     ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
#     CLOUD_ML_REGION=us-east5
#     GOOGLE_CLOUD_PROJECT=your-gcp-project-id
#
# ── How to set variables on each OS ──────────────────────────────────
#
# macOS (zsh):
#   1. Open:  nano ~/.zshrc
#   2. Add each variable as:  export VAR_NAME=value
#   3. Save and reload:  source ~/.zshrc
#
# Linux (bash):
#   1. Open:  nano ~/.bashrc
#   2. Add each variable as:  export VAR_NAME=value
#   3. Save and reload:  source ~/.bashrc
#
# Windows (PowerShell):
#   Run for each variable:
#     [System.Environment]::SetEnvironmentVariable('VAR_NAME', 'value', 'User')
#   Then restart your terminal.
#
# Windows (Command Prompt):
#   Run for each variable:
#     setx VAR_NAME value
#   Then restart your terminal.
#
# Windows (GUI):
#   Settings > System > About > Advanced System Settings >
#   Environment Variables > under "User variables" click New,
#   then add each variable.
#
# ── Important notes ──────────────────────────────────────────────────
#
# LOCAL SERVERS: If using LM Studio or Ollama, the server MUST be
# running with a model loaded before you launch OpenClaude —
# otherwise you'll get connection errors.
#
# SWITCHING PROVIDERS: To temporarily switch, unset the relevant
# variables in your current terminal session:
#
#   macOS / Linux:
#     unset VAR_NAME
#     # e.g.: unset CLAUDE_CODE_USE_OPENAI OPENAI_BASE_URL OPENAI_MODEL
#
#   Windows (PowerShell — current session only):
#     Remove-Item Env:VAR_NAME
#
#   To permanently remove a variable on Windows:
#     [System.Environment]::SetEnvironmentVariable('VAR_NAME', $null, 'User')
#
# LOAD ORDER:
#   Shell and system environment variables are inherited by the process.
#   Project .env files are only used if your launcher or shell loads them
#   before starting OpenClaude.
# COMPATIBILITY:
#   System-wide variables work regardless of how you run OpenClaude:
#   npx, global npm install, bun run, or node directly. Any process
#   launched from your terminal inherits your shell's environment.
#
# REMINDER: Make sure .env is in your .gitignore to avoid committing secrets.
#
# MCP Router:
#   .mcp.json reads this token from the environment. Local desktop runs also
#   use scripts/mcp-router-headers.cjs to prefer the project .env token when a
#   stale machine-level MCPR_TOKEN exists.
#   MCPR_TOKEN=mcpr-your-token-here
#   MCPR_HOST=127.0.0.1
#   MCPR_PORT=3282
#   OPENCLAUDE_DOCKER_MCPR_HOST=host.docker.internal
# =============================================================================

# =============================================================================
# PROVIDER SELECTION — uncomment ONE block below
# =============================================================================

# -----------------------------------------------------------------------------
# Option 1: Anthropic (default — no provider flag needed)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Override the default model (optional)
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Use a custom Anthropic-compatible endpoint (optional)
# ANTHROPIC_BASE_URL=https://api.anthropic.com


# -----------------------------------------------------------------------------
# Option 2: OpenAI
# -----------------------------------------------------------------------------
# CLAUDE_CODE_USE_OPENAI=1
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o

# Use a custom OpenAI-compatible endpoint (optional — defaults to api.openai.com)
# OPENAI_BASE_URL=https://api.openai.com/v1


# -----------------------------------------------------------------------------
# Option 3: Google Gemini
# -----------------------------------------------------------------------------
# CLAUDE_CODE_USE_GEMINI=1
# GEMINI_API_KEY=your-gemini-key-here
# GEMINI_MODEL=gemini-2.0-flash

# Use a custom Gemini endpoint (optional)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai


# -----------------------------------------------------------------------------
# Option 4: GitHub Models
# -----------------------------------------------------------------------------
# CLAUDE_CODE_USE_GITHUB=1
# GITHUB_TOKEN=ghp_your-token-here


# -----------------------------------------------------------------------------
# Option 5: Ollama (local models)
# -----------------------------------------------------------------------------
# CLAUDE_CODE_USE_OPENAI=1
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2

# -----------------------------------------------------------------------------
# Option 6: LM Studio (local models)
# -----------------------------------------------------------------------------
# LM Studio exposes an OpenAI-compatible API, so we use the OpenAI provider.
# Make sure LM Studio is running with the Developer server enabled
# (Developer tab > toggle server ON).
#
# Steps:
#   1. Download and install LM Studio from https://lmstudio.ai
#   2. Search for and download a model (e.g. any coding or instruct model)
#   3. Load the model and start the Developer server
#   4. Set OPENAI_MODEL to the model ID shown in LM Studio's Developer tab
#
# The default server URL is http://localhost:1234 — change the port below
# if you've configured a different one in LM Studio.
#
# OPENAI_API_KEY is optional — LM Studio runs locally and ignores it.
# Some clients require a non-empty value; if you get auth errors, set it
# to any dummy value (e.g. "lmstudio").
#
# CLAUDE_CODE_USE_OPENAI=1
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=your-model-id-here
# OPENCLAUDE_OPENAI_TEXT_TOOL_MODE=auto
# `auto` keeps native OpenAI/Hugging Face function calling when supported and
# retries known local GGUF chat-template failures through the agent tool adapter.
# Advanced overrides: `native` disables fallback; `text` forces compatibility.


# -----------------------------------------------------------------------------
# Option 7: OnlySQ
# -----------------------------------------------------------------------------
# OnlySQ exposes an OpenAI-compatible API at /ai/openai. Do not append /v1.
# The default model below is the one verified with agent tool calls.
#
# CLAUDE_CODE_USE_OPENAI=1
# OPENAI_BASE_URL=https://api.onlysq.ru/ai/openai
# OPENAI_MODEL=gemini-3-flash
# OPENAI_API_KEY=sq-your-key-here


# -----------------------------------------------------------------------------
# Option 8: AWS Bedrock
# -----------------------------------------------------------------------------

# You may also need AWS CLI credentials configured (run: aws configure)
# or have AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY set in your
# environment in addition to the variables below.
#
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=your-bearer-token-here
# ANTHROPIC_BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com


# -----------------------------------------------------------------------------
# Option 9: Google Vertex AI
# -----------------------------------------------------------------------------
# CLAUDE_CODE_USE_VERTEX=1
# ANTHROPIC_VERTEX_PROJECT_ID=your-gcp-project-id
# CLOUD_ML_REGION=us-east5
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id


# -----------------------------------------------------------------------------
# Option 10: NVIDIA NIM
# -----------------------------------------------------------------------------
# NVIDIA NIM provides hosted inference endpoints for NVIDIA models.
# Get your API key from https://build.nvidia.com/
#
# CLAUDE_CODE_USE_OPENAI=1
# NVIDIA_API_KEY=nvapi-your-key-here
# OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
# OPENAI_MODEL=nvidia/llama-3.1-nemotron-70b-instruct


# -----------------------------------------------------------------------------
# Option 10: MiniMax
# -----------------------------------------------------------------------------
# MiniMax API provides text generation models.
# Get your API key from https://platform.minimax.io/
#
# CLAUDE_CODE_USE_OPENAI=1
# MINIMAX_API_KEY=your-minimax-key-here
# OPENAI_BASE_URL=https://api.minimax.io/v1
# OPENAI_MODEL=MiniMax-M2.5


# =============================================================================
# OPTIONAL TUNING
# =============================================================================

# =============================================================================
# AGENT GATEWAY / TELEGRAM / OPEN WEBUI (OPTIONAL)
# =============================================================================
# These mirror the /agent-gateway UI. Values can also be saved interactively
# in ~/.openclaude/agent-gateway.json.
#
# OpenAI-compatible agent API for Open WebUI or any external client:
# OPENCLAUDE_AGENT_API_ENABLED=1
# OPENCLAUDE_AGENT_GATEWAY_SERVER=1
# OPENCLAUDE_AGENT_API_HOST=127.0.0.1
# OPENCLAUDE_AGENT_API_PORT=8642
# OPENCLAUDE_AGENT_API_KEY=ocag_generate_a_real_key_in_agent_gateway
# Optional inference-only key for OpenWebUI and OpenAI-compatible clients.
# It cannot manage MCP servers, skills, files, providers, or gateway settings.
# OPENCLAUDE_AGENT_INFERENCE_API_KEY=ocag_inference_generate_a_separate_key
# OPENCLAUDE_AGENT_API_CORS_ORIGINS=http://localhost:8080
# OPENCLAUDE_API_MAX_BODY_BYTES=268435456
# Maximum decoded bytes per visual input, images per request, and local
# retention for content-addressed API image files. The defaults are 20 MiB,
# 8 images, and 7 days. Remote image URLs are not fetched by the gateway.
# OPENCLAUDE_VISION_MAX_IMAGE_BYTES=20971520
# OPENCLAUDE_VISION_MAX_IMAGES=8
# OPENCLAUDE_VISION_RETENTION_MS=604800000
# OPENCLAUDE_FILE_MANAGER_MAX_UPLOAD_BYTES=1073741824
# OPENCLAUDE_API_RUN_RETENTION_MS=900000
# OPENCLAUDE_API_RUN_MAX_BUFFERED_EVENTS=4096
# OPENCLAUDE_TELEGRAM_FETCH_TIMEOUT_MS=70000
# OPENCLAUDE_TELEGRAM_SHUTDOWN_TIMEOUT_MS=15000
# OPENCLAUDE_TELEGRAM_MAX_QUEUED_PER_CHAT=50
# OPENCLAUDE_TELEGRAM_MAX_QUEUED_TOTAL=500
# Wait briefly to reassemble text that Telegram splits near its 4096-char limit.
# OPENCLAUDE_TELEGRAM_TEXT_SPLIT_COALESCE_MS=750
#
# Production network defaults. Keep these on loopback unless an authenticated
# TLS reverse proxy is configured and OPENCLAUDE_ALLOW_PUBLIC_BIND=1 is set.
# OPENCLAUDE_AGENT_API_BIND_ADDRESS=127.0.0.1
# OPENCLAUDE_AGENT_WEB_BIND_ADDRESS=127.0.0.1
# OPENCLAUDE_AGENT_WORKER_BIND_ADDRESS=127.0.0.1
# OPENCLAUDE_OPEN_WEBUI_BIND_ADDRESS=127.0.0.1
# OPENCLAUDE_OLLAMA_BIND_ADDRESS=127.0.0.1
# LIGHTRAG_BIND_ADDRESS=127.0.0.1
# HINDSIGHT_BIND_ADDRESS=127.0.0.1
# SESSION_SECRET=generate_a_random_32_byte_secret
# OPENCLAUDE_ALLOW_PUBLIC_BIND=0
# OPENCLAUDE_DOCKER_LOG_MAX_SIZE=20m
# OPENCLAUDE_DOCKER_LOG_MAX_FILES=5
#
# Durable memory storage is unlimited by default. A value of 0/unlimited keeps
# every source entry. Active API/Telegram/history prompt views use the selected
# model's physical window in auto mode; set the *_CONTEXT_CHARS overrides below
# to 0/unlimited/1m when you deliberately want a larger manual prompt view.
# OPENCLAUDE_CONTEXT_WINDOW_TOKENS=auto
# OPENCLAUDE_MAX_CONTEXT_TOKENS=auto
# CLAUDE_CODE_MAX_CONTEXT_TOKENS=auto
# OPENCLAUDE_API_CONTEXT_CHARS=auto
# OPENCLAUDE_TELEGRAM_CONTEXT_CHARS=auto
# OPENCLAUDE_MEMORY_CONTEXT_CHARS=auto
# OPENCLAUDE_MEMORY_MAX_CHARS=0
# OPENCLAUDE_USER_MEMORY_MAX_CHARS=0
# OPENCLAUDE_SCRATCHPAD_MAX_BLOCKS=0
# OPENCLAUDE_DIALOGUE_CONTEXT_BLOCKS=0
# OPENCLAUDE_DIALOGUE_BLOCK_MAX_CHARS=0
# OPENCLAUDE_MEMORY_BIBLE_MAX_CHARS=0
# OPENCLAUDE_MEMORY_ARCHITECTURE_MAX_CHARS=0
# OPENCLAUDE_MEMORY_REPO_GUIDE_MAX_CHARS=0
#
# Docker/UI-style provider aliases. In containers these map to the native
# provider env above. Native variables still work and take precedence.
# OPENCLAUDE_PROVIDER=openai
# OPENCLAUDE_BASE_URL=https://api.onlysq.ru/ai/openai
# OPENCLAUDE_MODEL=gemini-3-flash
# OPENCLAUDE_API_KEY=sq-your-key-here
# OPENROUTER_API_KEY=sk-or-your-key-here
# OPENCODE_ZEN_API_KEY=your-opencode-zen-key-here
#
# Docker can inherit the provider above, or use a separate API/model:
# OPENCLAUDE_DOCKER_PROVIDER=openai
# OPENCLAUDE_DOCKER_BASE_URL=https://api.onlysq.ru/ai/openai
# OPENCLAUDE_DOCKER_MODEL=gemini-3-flash
# OPENCLAUDE_DOCKER_API_KEY=sq-your-docker-key-here
# OPENCLAUDE_DOCKER_RUN_AS_ROOT=1
# OPENCLAUDE_ALLOW_ROOT_BYPASS_PERMISSIONS=1
# Keep API/OpenWebUI/test responses out of Telegram by default. Set to 1 only
# when you intentionally want every API response mirrored into the home chat.
# OPENCLAUDE_TELEGRAM_MIRROR_API_RESPONSES=0
# CodeGraph MCP is enabled by the project .mcp.json. Docker initializes the
# local .codegraph SQLite index once and its MCP watcher keeps it synchronized.
# OPENCLAUDE_CODEGRAPH_AUTO_INIT=1
# OPENCLAUDE_CODEGRAPH_PROJECT_PATH=/workspace
# CODEGRAPH_TELEMETRY=0
# SearXNG and Context7 MCP are also enabled by the project .mcp.json. Compose
# starts a private SearXNG service automatically and exposes it on loopback only.
# OPENCLAUDE_SEARXNG_HOST_PORT=18088
# SEARXNG_SECRET=replace-before-exposing-searxng-publicly
# SEARXNG_MAX_RESULTS=10
# SEARXNG_TIMEOUT_MS=20000
# CONTEXT7_API_KEY=ctx7-your-optional-key-here
# Official remote GitHub MCP. Keep the PAT only in .env and rotate it regularly.
# GITHUB_MCP_PAT=github-personal-access-token
# Semantic model routing uses the configured gateway-explore route and falls
# back to deterministic heuristics if the bounded classifier is unavailable.
# OPENCLAUDE_AGENT_SEMANTIC_ROUTING=1
# OPENCLAUDE_AGENT_SEMANTIC_ROUTER_TIMEOUT_MS=20000
# PENTEST_STATE_DIR=/workspace/.openclaude-data/pentest
# PENTEST_GATEWAY_AUTH_TOKEN=replace-with-at-least-32-random-characters
# Android-MCP (Android 10+, ADB, Python 3.13):
# Leave ANDROID_MCP_DEVICE empty when profiles are managed through /android.
# ANDROID_ADB_COMMAND=adb
# ANDROID_MCP_DEVICE=
# ANDROID_MCP_CONNECTION=auto
# ANDROID_MCP_HOST=
# ANDROID_MCP_BIN=android-mcp
# ANDROID_MCP_SCREENSHOT_QUANTIZED=true
# Optional Docker-to-host ADB socket for USB devices. Bind the host ADB server
# only to trusted interfaces/firewall rules; prefer direct WiFi ADB otherwise.
# OPENCLAUDE_ANDROID_ADB_SERVER_SOCKET=
# Live discovery is opt-in in the standalone preflight because upstream
# Android-MCP may use ADB mDNS when no devices are visible.
# OPENCLAUDE_ANDROID_MCP_TEST_DISCOVER=0
# For a host-native agent, point its MCP process at the loopback endpoint:
# SEARXNG_URL=http://127.0.0.1:18088
#
# Telegram MCP (personal/multi-account Telethon + Maton):
# Docker runs one shared HTTP MCP process so concurrent agent tasks do not
# open the same SQLite session files independently. Get API credentials at
# https://my.telegram.org/apps. Runtime data is never committed.
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# TELEGRAM_SESSION_NAME=telegram_session
# TELEGRAM_SESSION_STRING=
# Portable default: ./.openclaude-data/telegram-mcp (created by openclaude.ps1
# or openclaude.sh). Existing installations may point to any absolute path.
# OPENCLAUDE_HOST_TELEGRAM_MCP_DIR=./.openclaude-data/telegram-mcp
# Production control resolves these automatically to absolute host paths.
# Set them explicitly when Compose is launched from a wrapper or another cwd.
# OPENCLAUDE_HOST_HOME=/home/user
# OPENCLAUDE_HOST_WORKSPACE_DIR=/absolute/path/to/openclaude-agent
# OPENCLAUDE_HOST_CONFIG_DIR=/home/user/.openclaude
# OPENCLAUDE_COMPOSE_PROJECT_NAME=openclaude-agent
# TELEGRAM_MCP_WEB_BIND_ADDRESS=127.0.0.1
# TELEGRAM_MCP_WEB_HOST_PORT=19765
# TELEGRAM_MCP_WEB_TOKEN=
# MATON_API_URL=https://api.maton.ai
# MATON_API_KEY=
# MATON_TIMEOUT=30
# TWIBOOST_API_URL=https://twiboost.com/api/v2
# TWIBOOST_API_KEY=
# TWIBOOST_TIMEOUT=30
# Codex subscription auth: Docker mounts this host directory and reads its
# refreshable auth.json plus models_cache.json. Portable deployments import
# these into the ignored local state directory.
# OPENCLAUDE_HOST_CODEX_DIR=./.openclaude-data/codex
# Docker compose also starts the agent containers as user 0:0 with privileged
# mode enabled so Telegram/API-launched agent tasks do not hit Linux uid/capability
# permission denials inside the container.
#
# Telegram bridge:
# TELEGRAM_BOT_TOKEN=123456:bot-token-from-botfather
# OPENCLAUDE_TELEGRAM_ENABLED=1
# OPENCLAUDE_TELEGRAM_HOME_CHAT_ID=123456789
# OPENCLAUDE_TELEGRAM_ALLOWED_CHAT_IDS=123456789,-1001234567890
# OPENCLAUDE_TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# OPENCLAUDE_TELEGRAM_AGENT_RECOVERY_ATTEMPTS=2
# Transient provider/network retries use exponential bounded backoff.
# OPENCLAUDE_TELEGRAM_AGENT_RECOVERY_BACKOFF_MS=1000
# OPENCLAUDE_TELEGRAM_AGENT_RECOVERY_BACKOFF_MAX_MS=30000
# Telegram Bot API delivery retries are bounded and apply only to transient
# network, HTTP 429, and HTTP 5xx failures.
# OPENCLAUDE_TELEGRAM_HTTP_ATTEMPTS=3
# Failed cron deliveries remain pending and retry without consuming the run.
# OPENCLAUDE_CRON_RETRY_SECONDS=60
# 0/unlimited removes the total retry cap, but this is not recommended for
# Telegram production. Keep per-attempt watchdogs and failure-class limits on.
# OPENCLAUDE_TELEGRAM_AGENT_FAILURE_KIND_LIMIT=2
#
# If both allowed chat IDs and allowed user IDs are empty, Telegram access is
# open by design. Once any allowlist/home chat is set, other users/chats are
# ignored.
#
# Docker compose does NOT reuse the local Telegram bot by default. This avoids
# duplicate replies when local and Docker agent instances run at the same time.
# Set these only when the Docker instance should have Telegram access.
# OPENCLAUDE_DOCKER_TELEGRAM_ENABLED=1
# OPENCLAUDE_DOCKER_TELEGRAM_BOT_TOKEN=123456:docker-bot-token
# The same Docker bot token is exposed only inside telegram-mcp as its local
# Bot API publisher fallback; MCP tools never return the token.
# TELEGRAM_MCP_BOT_TIMEOUT=30
# OPENCLAUDE_DOCKER_TELEGRAM_HOME_CHAT_ID=123456789
# OPENCLAUDE_DOCKER_TELEGRAM_ALLOWED_CHAT_IDS=123456789,-1001234567890
# OPENCLAUDE_DOCKER_TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
#
# Cron and Ouroboros:
# OPENCLAUDE_AGENT_CRON_ENABLED=1
# OPENCLAUDE_AGENT_CRON_TICK_SECONDS=60
# OPENCLAUDE_TELEGRAM_CRON_TIMEZONE=Europe/Simferopol
# OPENCLAUDE_OUROBOROS_ENABLED=1
# OPENCLAUDE_CONSCIOUSNESS_ENABLED=1
# OPENCLAUDE_INFINITE_TASKS_ENABLED=1
# OPENCLAUDE_OUROBOROS_WAKEUP_MIN_SECONDS=300
# OPENCLAUDE_OUROBOROS_WAKEUP_MAX_SECONDS=7200
# OPENCLAUDE_OUROBOROS_MAX_ROUNDS=3
# OPENCLAUDE_OUROBOROS_BUDGET_FRACTION=0.1
# OPENCLAUDE_EVOLUTION_INTERVAL_SECONDS=21600
# OPENCLAUDE_MCP_PREFLIGHT=1
# OPENCLAUDE_MCP_PREFLIGHT_STRICT=1
#
# Docker worker/replica defaults keep Telegram and autonomous loops off.
# Set these only when intentionally launching a Telegram-enabled worker bot:
# OPENCLAUDE_REPLICA_TELEGRAM_ENABLED=1
# OPENCLAUDE_REPLICA_TELEGRAM_BOT_TOKEN=123456:replica-bot-token
# OPENCLAUDE_REPLICA_TELEGRAM_HOME_CHAT_ID=123456789
# OPENCLAUDE_REPLICA_TELEGRAM_ALLOWED_USER_IDS=123456789
# OPENCLAUDE_REPLICA_CRON_ENABLED=1
# OPENCLAUDE_REPLICA_CRON_TICK_SECONDS=60
# OPENCLAUDE_REPLICA_OUROBOROS_ENABLED=1
# OPENCLAUDE_REPLICA_CONSCIOUSNESS_ENABLED=1
# OPENCLAUDE_REPLICA_INFINITE_TASKS_ENABLED=1
# OPENCLAUDE_REPLICA_OUROBOROS_WAKEUP_MIN_SECONDS=300
# OPENCLAUDE_REPLICA_OUROBOROS_WAKEUP_MAX_SECONDS=7200
# OPENCLAUDE_REPLICA_OUROBOROS_MAX_ROUNDS=3
# OPENCLAUDE_REPLICA_OUROBOROS_BUDGET_FRACTION=0.1
# OPENCLAUDE_REPLICA_EVOLUTION_INTERVAL_SECONDS=21600
# OPENCLAUDE_REPLICA_SEARXNG_URL=http://host.docker.internal:18088
#
# Docker compose fixed workers also accept:
# OPENCLAUDE_WORKER_TELEGRAM_ENABLED=1
# OPENCLAUDE_WORKER_TELEGRAM_BOT_TOKEN=123456:worker-bot-token
# OPENCLAUDE_WORKER_TELEGRAM_HOME_CHAT_ID=123456789
# OPENCLAUDE_WORKER_TELEGRAM_ALLOWED_USER_IDS=123456789
#
# Runner process used by API/Telegram/cron/Ouroboros tasks:
# OPENCLAUDE_AGENT_RUNNER_CWD=/absolute/project/or/workspace/path
# OPENCLAUDE_AGENT_RUNNER_MAX_TURNS=720
# OPENCLAUDE_AGENT_RUNNER_TIMEOUT_MS=1800000
# Once the structured CLI emits a terminal success result, wait only this long
# for normal process shutdown before closing the completed run ourselves.
# OPENCLAUDE_AGENT_TERMINAL_RESULT_GRACE_MS=1000
# Stop an execution branch after this many identical failed tool completions
# without new verified progress. Successful and polling calls use higher
# derived thresholds, so this normally does not need tuning.
# OPENCLAUDE_AGENT_LOOP_REPEAT_LIMIT=3
# Stop a structured-progress child run that produces no output for this long.
# The production default is 15 minutes; set 0 to disable the idle watchdog.
# OPENCLAUDE_AGENT_RUNNER_STALL_TIMEOUT_MS=900000
# Enabled MCP servers are eligible capabilities. By default the runner creates
# an isolated task-scoped MCP profile for every run and selects only relevant
# eligible servers. Hindsight is selected for explicit memory and prior-context
# requests instead of adding its schemas to every conversational turn.
# Naming an imported server selects it, while an explicit "all tools"/"all MCP"
# request selects every eligible server. Set 0 to pass every enabled server to
# every normal run instead.
# OPENCLAUDE_AGENT_AUTO_MCP_ROUTING=1
# Ouroboros is the fixed execution harness. Legacy harness values are migrated
# automatically and no mode selection is required.
# After a coding task mutates files, require a successful post-edit verifier
# (tests, typecheck, lint, build, or another relevant check), with up to three
# bounded correction passes.
# OPENCLAUDE_AGENT_CODING_COMPLETION_GATE=1
# Enable verifier-first, timeout-aware execution discipline for Terminal-Bench
# and other long terminal coding tasks.
# OPENCLAUDE_TERMINAL_BENCH=0
# CLAUDE_CODE_MAX_RETRIES=3
# API_TIMEOUT_MS=60000
# OPENCLAUDE_AGENT_RUNNER_PERMISSION_MODE=bypassPermissions
# Leave empty for full tool access, including WebSearch. Set a comma/space list
# only when you intentionally want to block tools in gateway child runs.
# OPENCLAUDE_AGENT_RUNNER_DISALLOWED_TOOLS=
# Optional allowlist managed by the Tool Router. Leave empty to expose every
# built-in tool that is not present in the disallowed list.
# OPENCLAUDE_AGENT_RUNNER_TOOLS=
# Comma-separated native/bundled skill names disabled by the Tool Router.
# OPENCLAUDE_DISABLED_SKILLS=
#
# Open WebUI local app launcher:
# OPENCLAUDE_OPEN_WEBUI_HOST=localhost
# OPENCLAUDE_OPEN_WEBUI_PORT=8080
# OPENCLAUDE_OPEN_WEBUI_PYTHON=python3.11
# OPENCLAUDE_OPEN_WEBUI_DATA_DIR=~/.open-webui
# OPENCLAUDE_AGENT_UI_LANGUAGE=en
#
# LightRAG knowledge graph/vector RAG and MCP integration. The production
# compose stack pins the image digest and persists /app/data in a named volume.
# OPENCLAUDE_LIGHTRAG_ENABLED=1
# LIGHTRAG_URL=http://localhost:9621
# OPENCLAUDE_DOCKER_LIGHTRAG_URL=http://lightrag:9621
# LIGHTRAG_HOST_PORT=9621
# LIGHTRAG_BIND_ADDRESS=127.0.0.1
# Optional API authentication. Loopback-only deployments may leave this empty;
# set a strong value before exposing LightRAG beyond the host.
# LIGHTRAG_API_KEY=
# OPENCLAUDE_LIGHTRAG_MCP_ENABLED=1
# LIGHTRAG_MCP_TIMEOUT=180
# LIGHTRAG_MCP_MAX_RETRIES=2
# Defaults are local and cost-free through a dedicated Ollama container. A
# private compatibility adapter sends think=false so graph extraction does not
# burn time on Qwen reasoning. Override all provider fields together for cloud.
# LIGHTRAG_LLM_BINDING=ollama
# LIGHTRAG_LLM_BINDING_HOST=http://lightrag-ollama-adapter:11435
# LIGHTRAG_LLM_BINDING_API_KEY=
# LIGHTRAG_LLM_MODEL=qwen3-lightrag:1.7b
# LIGHTRAG_LLM_TIMEOUT=900
# LIGHTRAG_LLM_NUM_CTX=8192
# LIGHTRAG_LLM_NUM_PREDICT=2048
# LIGHTRAG_FORCE_NO_THINK=1
# Recommended production extraction profile when DEEPSEEK_API_KEY is set:
# LIGHTRAG_LLM_BINDING=openai
# LIGHTRAG_LLM_BINDING_HOST=https://api.deepseek.com/v1
# LIGHTRAG_LLM_MODEL=deepseek-v4-flash
# The compose service reuses DEEPSEEK_API_KEY unless this override is set:
# LIGHTRAG_LLM_BINDING_API_KEY=
# LIGHTRAG_EMBEDDING_BINDING=ollama
# LIGHTRAG_EMBEDDING_BINDING_HOST=http://lightrag-ollama:11434
# LIGHTRAG_EMBEDDING_MODEL=nomic-embed-text:latest
# LIGHTRAG_EMBEDDING_DIM=768
# LIGHTRAG_EMBEDDING_TOKEN_LIMIT=8192
# LIGHTRAG_SUMMARY_LANGUAGE=Russian
# LIGHTRAG_MAX_EXTRACTION_RECORDS=60
# LIGHTRAG_MAX_EXTRACTION_ENTITIES=30
# LIGHTRAG_MAX_ASYNC_LLM=1
# LIGHTRAG_MAX_PARALLEL_INSERT=1
# LIGHTRAG_OLLAMA_KEEP_ALIVE=30m
# Embedding model and dimension are immutable after first indexing. Reindex into
# a fresh LightRAG volume if either value changes.
# Migrate a legacy OpenRAG OpenSearch index with:
# npm run release:lightrag:migrate
#
# Camofox browser MCP integration:
# CAMOFOX_URL=http://localhost:9377
# CAMOFOX_PORT=9377
# CAMOFOX_ACCESS_KEY=
# CAMOFOX_API_KEY=
# CAMOFOX_MCP_USER_ID=openclaude-agent
# CAMOFOX_MCP_SESSION_KEY=default
# CAMOFOX_MCP_TIMEOUT=60
# Persistent cookies/localStorage remain outside the repository. The Qwen
# collaborator uses the fixed userId nova-qwen-max in this directory.
# CAMOFOX_PROFILE_DIR=~/.camofox/profiles
# OPENCLAUDE_CAMOFOX_AUTH_DIR=~/.openclaude/camofox-auth
# Optional browser AI routing registry. It contains profile metadata only,
# never cookies, OAuth tokens, or passwords.
# OPENCLAUDE_BROWSER_MODEL_REGISTRY=~/.openclaude/camofox-auth/browser-model-profiles.json
# OPENCLAUDE_CAMOFOX_LOGIN_TIMEOUT_MS=900000
# Keep browser sessions and navigator tabs alive for seven days by default.
# OPENCLAUDE_CAMOFOX_KEEPALIVE_MS=604800000
# OPENCLAUDE_CAMOFOX_VERSION=1.13.0
# OPENCLAUDE_DOCKER_CAMOFOX_URL=http://host.docker.internal:9377
#
# Hindsight durable memory integration:
# HINDSIGHT_URL=http://localhost:8888
# HINDSIGHT_API_KEY=
# HINDSIGHT_BANK_ID=openclaude-agent
# HINDSIGHT_MCP_TIMEOUT=60
# HINDSIGHT_API_PORT=8888
# HINDSIGHT_UI_PORT=9999
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_API_KEY=
# HINDSIGHT_API_LLM_MODEL=
# HINDSIGHT_API_LLM_BASE_URL=
# Optional existing Docker network. Portable deployments set this
# automatically so Hindsight stays reachable without public port binds.
# HINDSIGHT_DOCKER_NETWORK=openclaude-agent_default
# OPENCLAUDE_DOCKER_HINDSIGHT_URL=http://openclaude-hindsight:8888
#
# Docker host port overrides. Container-to-container networking still uses
# openclaude-agent:8642; these only control what is exposed on the host.
# OPENCLAUDE_AGENT_API_HOST_PORT=8642
# Keep the root-capable gateway private to this machine. Open WebUI still
# reaches it through the Docker network, and Telegram does not require an
# inbound gateway port.
# OPENCLAUDE_AGENT_API_BIND_ADDRESS=127.0.0.1
# OPENCLAUDE_OPEN_WEBUI_HOST_PORT=8080
# Optional public links shown by Telegram /help and the Tool Router. Set these
# when the services are published through a reverse proxy or another machine.
# OPENCLAUDE_ROUTER_PUBLIC_URL=http://localhost:8642/router
# OPENCLAUDE_FILE_MANAGER_PUBLIC_URL=http://localhost:8642/files
# Issue a signed HttpOnly browser session when /router or /files is opened on
# localhost. The API key is never embedded in HTML. Requests with a non-loopback
# Host header still require entering the key once.
# OPENCLAUDE_CONSOLE_AUTO_SESSION=1
# OPENCLAUDE_CONSOLE_SESSION_TTL_MS=43200000
# Legacy compatibility only: embeds the API key in HTML. Keep disabled.
# OPENCLAUDE_ROUTER_AUTO_AUTH=0
# Local voice transcription is bundled in Docker and selected first by auto.
# Models are cached in the persistent OpenClaude home volume.
# OPENCLAUDE_TELEGRAM_TRANSCRIPTION_PROVIDER=auto
# OPENCLAUDE_TELEGRAM_TRANSCRIPTION_WHISPER_MODEL=base
# OPENCLAUDE_TELEGRAM_TRANSCRIPTION_TIMEOUT_MS=300000
# OPENCLAUDE_OPEN_WEBUI_PUBLIC_URL=http://localhost:8080
# OpenWebUI voice mode uses local faster-whisper when STT_ENGINE is empty and
# browser speech for TTS when TTS_ENGINE is empty. Screen/camera mode attaches
# one current frame to each completed voice turn; NOVA routes that frame to the
# local Qwen-MM vision model before the coordinator answers.
# OPENCLAUDE_OPEN_WEBUI_STT_ENGINE=
# OPENCLAUDE_OPEN_WEBUI_TTS_ENGINE=
# OPENCLAUDE_OPEN_WEBUI_WHISPER_MODEL=base
# OPENCLAUDE_OPEN_WEBUI_WHISPER_COMPUTE_TYPE=int8
# OPENCLAUDE_OPEN_WEBUI_WHISPER_VAD_FILTER=True
# OPENCLAUDE_OPEN_WEBUI_IMAGE_MAX_WIDTH=1280
# OPENCLAUDE_OPEN_WEBUI_IMAGE_MAX_HEIGHT=1280
# HINDSIGHT_PUBLIC_URL=http://localhost:8888
# LIGHTRAG_PUBLIC_URL=http://localhost:9621/webui
# TELEGRAM_MCP_WEB_PUBLIC_URL=http://localhost:19765
# OmniRoute dashboard and OpenAI-compatible API. The compose stack exposes this
# on loopback only and agents reach it at http://omniroute:20128/v1.
# OMNIROUTE_PUBLIC_URL=http://localhost:20128
# OMNIROUTE_HOST_PORT=20128
# OMNIROUTE_BIND_ADDRESS=127.0.0.1
# OMNIROUTE_API_KEY=sk_omniroute
# OMNIROUTE_REQUIRE_API_KEY=false
# OMNIROUTE_MEMORY_MB=2048
# Generate these once for production and keep them outside version control.
# OMNIROUTE_INITIAL_PASSWORD=
# OMNIROUTE_STORAGE_ENCRYPTION_KEY=
# OMNIROUTE_JWT_SECRET=
# OMNIROUTE_API_KEY_SECRET=
# OMNIROUTE_WS_BRIDGE_SECRET=
# Portable Capability Router. The web UI and MCP endpoint are published on
# loopback; Docker uses OmniRoute as its semantic selector by default.
# CAPABILITY_ROUTER_HOST_PORT=19868
# CAPABILITY_ROUTER_BIND_ADDRESS=127.0.0.1
# CAPABILITY_ROUTER_API_KEY=
# Localhost browser sessions avoid exposing or manually entering the API key.
# Remote hosts and the /mcp endpoint still require the Bearer key.
# CAPABILITY_ROUTER_AUTO_SESSION=1
# CAPABILITY_ROUTER_SESSION_TTL_MS=43200000
# CAPABILITY_ROUTER_MAX_SERVERS=4
# CAPABILITY_ROUTER_MAX_TOOLS=20
# CAPABILITY_ROUTER_LLM_BASE_URL=http://omniroute:20128/v1
# CAPABILITY_ROUTER_LLM_MODEL=auto/best-fast
# CAPABILITY_ROUTER_LLM_API_KEY=sk_omniroute
# Local Qwen-MM tool layer. Docker pulls the model into the persistent Ollama
# volume during bootstrap; no DashScope/Qwen API credential is used.
# OPENCLAUDE_QWEN_MM_ENABLED=1
# QWEN_MM_MODEL=qwen3-vl:2b-instruct
# QWEN_MM_BASE_URL=http://openclaude-ollama:11434/v1
# QWEN_MM_TIMEOUT_MS=300000
# Native host alternative: QWEN_MM_BASE_URL=http://127.0.0.1:11434/v1
# OPENCLAUDE_AGENT_WORKER_1_HOST_PORT=8741
# OPENCLAUDE_AGENT_WORKER_2_HOST_PORT=8742

# Max number of API retries on failure for gateway child runs (default: 3)
# Raise this only for trusted long-running providers; repeated 5xx/content
# policy failures otherwise make Telegram tasks look hung.
# CLAUDE_CODE_MAX_RETRIES=3

# Enable persistent retry mode for unattended/CI sessions
# Retries 429/529 indefinitely with smart backoff
# CLAUDE_CODE_UNATTENDED_RETRY=1

# Enable extended key reporting (Kitty keyboard protocol)
# Useful for iTerm2, WezTerm, Ghostty if modifier keys feel off
# OPENCLAUDE_ENABLE_EXTENDED_KEYS=1

# Disable "Co-authored-by" line in git commits made by OpenClaude
# OPENCLAUDE_DISABLE_CO_AUTHORED_BY=1

# Custom timeout for API requests in milliseconds (default: varies)
# API_TIMEOUT_MS=60000

# Enable debug logging
# CLAUDE_DEBUG=1


# =============================================================================
# WEB SEARCH (OPTIONAL)
# =============================================================================
# OpenClaude includes a web search tool. By default it uses DuckDuckGo (free)
# or the provider's native search (Anthropic firstParty / vertex).
#
# Set one API key below to enable a provider. That's it.

# ── Provider API keys — set ONE of these ────────────────────────────

# Tavily (AI-optimized search, recommended)
# TAVILY_API_KEY=tvly-your-key-here

# Exa (neural/semantic search)
# EXA_API_KEY=your-exa-key-here

# You.com (RAG-ready snippets)
# YOU_API_KEY=your-you-key-here

# Jina (s.jina.ai endpoint)
# JINA_API_KEY=your-jina-key-here

# Bing Web Search
# BING_API_KEY=your-bing-key-here

# Mojeek (privacy-focused)
# MOJEEK_API_KEY=your-mojeek-key-here

# Linkup
# LINKUP_API_KEY=your-linkup-key-here

# Firecrawl (premium, uses @mendable/firecrawl-js)
# FIRECRAWL_API_KEY=fc-your-key-here

# ── Provider selection mode ─────────────────────────────────────────
#
# WEB_SEARCH_PROVIDER controls fallback behavior:
#
#   "auto"      (default) — try all configured providers, fall through on failure
#   "custom"    — custom API only, throw on failure (NOT in auto chain)
#   "firecrawl" — firecrawl only
#   "tavily"    — tavily only
#   "exa"       — exa only
#   "you"       — you.com only
#   "jina"      — jina only
#   "bing"      — bing only
#   "mojeek"    — mojeek only
#   "linkup"    — linkup only
#   "ddg"       — duckduckgo only
#   "native"    — anthropic native / codex only
#
# Auto mode priority: firecrawl → tavily → exa → you → jina → bing → mojeek →
#                     linkup → ddg
# Note: "custom" is NOT in the auto chain. To use the custom API provider,
# you must explicitly set WEB_SEARCH_PROVIDER=custom.
#
# WEB_SEARCH_PROVIDER=auto
# Docker defaults this to custom + the bundled SearXNG service when neither
# WEB_SEARCH_PROVIDER nor WEB_PROVIDER is explicitly set.

# ── Built-in custom API presets ─────────────────────────────────────
#
# Use with WEB_KEY for the API key:
# WEB_PROVIDER=searxng|google|brave|serpapi
# WEB_KEY=your-api-key-here

# ── Custom API endpoint (advanced) ──────────────────────────────────
#
# WEB_SEARCH_API    — base URL of your search endpoint
# WEB_QUERY_PARAM         — query parameter name (default: "q")
# WEB_METHOD        — GET or POST (default: GET)
# WEB_PARAMS        — extra static query params as JSON: {"lang":"en","count":"10"}
# WEB_URL_TEMPLATE  — URL template with {query} for path embedding
# WEB_BODY_TEMPLATE — custom POST body with {query} placeholder
# WEB_AUTH_HEADER   — header name for API key (default: "Authorization")
# WEB_AUTH_SCHEME   — prefix before key (default: "Bearer")
# WEB_HEADERS       — extra headers as "Name: value; Name2: value2"
# WEB_JSON_PATH     — dot-path to results array in response

# ── Custom API security guardrails ──────────────────────────────────
#
# The custom provider enforces security guardrails by default.
# Override these only if you understand the risks.
#
# WEB_CUSTOM_TIMEOUT_SEC=15                  — request timeout in seconds (default 15)
# WEB_CUSTOM_MAX_BODY_KB=300                 — max POST body size in KB (default 300)
# WEB_CUSTOM_ALLOW_ARBITRARY_HEADERS=false   — set "true" to use non-standard headers
# WEB_CUSTOM_ALLOW_HTTP=false                — set "true" to allow http:// URLs
# WEB_CUSTOM_ALLOW_PRIVATE=false             — set "true" to target localhost/private IPs
#                                               (needed for self-hosted SearXNG)
# Runtime memory defaults. On Windows/WSL, allocate at least 12 GB RAM and
# 8 GB swap to Docker for the full production stack.

OPENCLAUDE_NODE_OPTIONS=--max-old-space-size=4096
OPENCLAUDE_MALLOC_ARENA_MAX=2
