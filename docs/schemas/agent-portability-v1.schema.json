{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaude.local/schemas/agent-portability-v1.json",
  "title": "OpenClaude agent portability descriptor",
  "type": "object",
  "required": ["schemaVersion", "agent", "workspace", "capabilities"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "agent": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "workspace": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "mcpConfigs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "registry": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "root"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
              },
              "root": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "skillRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
