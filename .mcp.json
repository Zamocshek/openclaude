{
  "mcpServers": {
    "mcp-router": {
      "command": "node",
      "args": [
        "scripts/mcp-router-launcher.cjs"
      ],
      "env": {
        "MCPR_TOKEN": "${MCPR_TOKEN}"
      }
    },
    "openrag": {
      "command": "node",
      "args": [
        "scripts/release/openrag-mcp-bridge.cjs"
      ],
      "env": {
        "OPENRAG_URL": "${OPENRAG_URL}",
        "OPENRAG_API_KEY": "${OPENRAG_API_KEY}",
        "OPENRAG_MCP_TIMEOUT": "60"
      }
    },
    "camofox": {
      "command": "node",
      "args": [
        "scripts/release/camofox-mcp-bridge.cjs"
      ],
      "env": {
        "CAMOFOX_URL": "${CAMOFOX_URL}",
        "CAMOFOX_MCP_USER_ID": "openclaude-agent",
        "CAMOFOX_MCP_SESSION_KEY": "default",
        "CAMOFOX_MCP_TIMEOUT": "60",
        "CAMOFOX_ACCESS_KEY": "${CAMOFOX_ACCESS_KEY}",
        "CAMOFOX_API_KEY": "${CAMOFOX_API_KEY}"
      }
    },
    "hindsight": {
      "command": "node",
      "args": [
        "scripts/release/hindsight-mcp-bridge.cjs"
      ],
      "env": {
        "HINDSIGHT_URL": "${HINDSIGHT_URL}",
        "HINDSIGHT_BANK_ID": "openclaude-agent",
        "HINDSIGHT_MCP_TIMEOUT": "60",
        "HINDSIGHT_API_KEY": "${HINDSIGHT_API_KEY}"
      }
    },
    "codegraph": {
      "command": "node",
      "args": [
        "scripts/codegraph-mcp.cjs",
        "serve",
        "--mcp"
      ],
      "env": {
        "CODEGRAPH_TELEMETRY": "0"
      }
    },
    "searxng": {
      "command": "node",
      "args": [
        "scripts/run-project-mcp.cjs",
        "mcp-searxng/dist/cli.js"
      ],
      "env": {
        "SEARXNG_URL": "${SEARXNG_URL}",
        "SEARXNG_MAX_RESULTS": "${SEARXNG_MAX_RESULTS}",
        "SEARXNG_TIMEOUT_MS": "${SEARXNG_TIMEOUT_MS}"
      }
    },
    "context7": {
      "command": "node",
      "args": [
        "scripts/run-project-mcp.cjs",
        "@upstash/context7-mcp/dist/index.js",
        "--transport",
        "stdio"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "telegram-mcp": {
      "type": "http",
      "url": "http://telegram-mcp:8766/mcp"
    }
  }
}
